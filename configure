#!/bin/bash

# Default values

platform=linux
doc='yes'
sysc_dir='/usr/local/systemc-3.0.0'
draft=

# Parse command-line arguments

configure_options="$*"

while : ; do
  case "$1" in
    "") break;;
    -platform|--platform)
        platform=$2; shift;;
    -no-doc|--no-doc)
        doc='';;
    -dot|--dot)
        dotprogram=$2; shift;;
    -dotviewer|--dotviewer)
        dotviewer=$2; shift;;
    -vcdviewer|--vcdviewer)
        vcdviewer=$2; shift;;
    -txtviewer|--txtviewer)
        txtviewer=$2; shift;;
    -rfsmc|--rfsmc)
        rfsmc=$2; shift;;
    -draft|--draft)
        draft='yes';;
    -help|--help)
        cat <<EOF
Usage: configure [options]
Options: [defaults in brackets after descriptions]
  --platform NAME         target platform (macos,linux,windows) [default: linux]
  --no-doc                do not build the documentation from sources
  --dot path              command for runing dot program 
  --dotviewer path        command for displaying .dot files
  --vcdviewer path        command for displaying .vcd files
  --txtviewer path        command for displaying text files
  --rfmsc path            path to the rfsmc compiler (to be copied in the install tree) 
  --draft                 build for local testing (not for building installers) [default: $draft]
  --help                  print this message
EOF
	exit 0;;
    *) echo "Unknown option \"$1\"." 1>&2; exit 2;;
  esac
  shift
done

rm -f config
touch config
echo "# generated by ./configure $configure_options" >> config
echo "PLATFORM=$platform" >> config
# set platform-dependent fallback values
case "$platform" in
  macos)
      if [ -z "$dotprogram" ]; then dotprogram="/usr/local/bin/dot"; fi;
      if [ -z "$dotviewer" ]; then dotviewer="/usr/local/bin/graphviz"; fi;
      if [ -z "$vcdviewer" ]; then vcdviewer="/opt/bin/gtkwave"; fi;
      if [ -z "$txtviewer" ]; then txtviewer="nano"; fi;
      echo "WINDEPLOYQT=unused_command" >> config;;
  linux)
      if [ -z "$dotprogram" ]; then dotprogram="/usr/bin/dot"; fi;
      if [ -z "$dotviewer" ]; then dotviewer="/usr/bin/dotty"; fi;
      if [ -z "$vcdviewer" ]; then vcdviewer="/usr/bin/gtkwave"; fi;
      if [ -z "$txtviewer" ]; then txtviewer="nano"; fi;
      echo "WINDEPLOYQT=unused_command" >> config;
      echo "INSTALL_DIR=./dist/linux/grasp" >> config;;
  windows)
      echo "PLATFORM=windows" >> config;
      if [ -z "$dotprogram" ]; then dotprogram="C:\Program Files\Graphviz\bin\dot.exe"; fi;
      if [ -z "$vcdviewer" ]; then vcdviewer="C:\Users\js\Desktop\gtkwave\gtkwave64\bin\gtkwave.exe"; fi;
      if [ -z "$txtviewer" ]; then txtviewer="notepad"; fi;
      echo "WINDEPLOYQT=windeployqt.exe" >> config;;
  *) 
      echo "Unknown platform: $platform";
      rm -f config;
      exit 3;;
esac
if [ -e VERSION ]; then
    cat VERSION >> config;
fi

# Write ./config

echo "RFSMC=$rfsmc" >> config
echo "DOTPROGRAM=$dotprogram" >> config
echo "DOTVIEWER=$dotviewer" >> config
echo "VCDVIEWER=$vcdviewer" >> config
echo "TXTVIEWER=$txtviewer" >> config
echo "BUILD_DOC=$doc" >> config
echo "** Wrote file ./config"

# Write ./dist/<platform>/grasp.ini

rm -f ./dist/$platform/grasp.ini
touch ./dist/$platform/grasp.ini

case "$platform" in
  macos)
      if [ -n "$draft" ]; then
          echo "COMPILER=../dist/macos/rfsmc.exe" >> ./dist/$platform/grasp.ini
      else
          echo "COMPILER=/Applications/Grasp.app/Contents/MacOS/rfsmc.exe" >> ./dist/$platform/grasp.ini
      fi;
      echo "DOTPROGRAM=$dotprogram" >> ./dist/$platform/grasp.ini;
      echo "DOTVIEWER=$dotviewer" >> ./dist/$platform/grasp.ini;
      echo "VCDVIEWER=$vcdviewer" >> ./dist/$platform/grasp.ini;
      echo "TXTVIEWER=$txtviewer" >> ./dist/$platform/grasp.ini;
      echo "INITDIR=~/Documents" >> ./dist/$platform/grasp.ini;;
  linux)
      if [ -n "$draft" ]; then
          echo "COMPILER=../dist/linux/rfsmc.exe" >> ./dist/$platform/grasp.ini
      else
          echo "COMPILER=/usr/lib/grasp/rfsmc.exe" >> ./dist/$platform/grasp.ini
      fi;
      echo "DOTPROGRAM=$dotprogram" >> ./dist/$platform/grasp.ini;
      echo "DOTVIEWER=$dotviewer" >> ./dist/$platform/grasp.ini;
      echo "VCDVIEWER=$vcdviewer" >> ./dist/$platform/grasp.ini;
      echo "TXTVIEWER=$txtviewer" >> ./dist/$platform/grasp.ini;
      echo "INITDIR=/usr/share/grasp/examples" >> ./dist/$platform/grasp.ini;;
  windows)
# These are temporary, dev-only locations. The definitive ones will be specified when running the Installer wizard
      if [ -n "$draft" ]; then
          echo "COMPILER=Z:/qt/grasp/dist/windows/rfsmc.exe" >> ./dist/$platform/grasp.ini
      else
          echo "COMPILER=Z:/qt/grasp/dist/windows/rfsmc.exe" >> ./dist/$platform/grasp.ini # TO FIX
      fi;
      echo "DOTPROGRAM=$dotprogram" >> ./dist/$platform/grasp.ini;
      echo "DOTVIEWER=$dotviewer" >> ./dist/$platform/grasp.ini;
      echo "VCDVIEWER=$vcdviewer" >> ./dist/$platform/grasp.ini;
      echo "TXTVIEWER=$txtviewer" >> ./dist/$platform/grasp.ini;
      echo "INITDIR=Z:/qt/grasp/examples" >> ./src/grasp.ini;;
  *) 
      echo "Unknown platform: $platform";
      exit 3;;
esac

echo "** Wrote file ./dist/$platform/grasp.ini"
