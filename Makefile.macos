# Makefile to build the MacOS distribution

include config
include VERSION # After config, whose VERSION may be outdated (it is only updated by ./configure)

.PHONY: build install installer

build: build-gui

INSTALL_DIR=./dist/macos
DEPLOY_DIR=./dist/macos/deploy
ARCH= $(shell arch)
MACDEPLOYQT=macdeployqt
QT_LIBS=$(shell qmake -query QT_INSTALL_LIBS)

build-gui:
	@echo "** Building GUI"
	(cd src; qmake; make)

install:
	@echo "** Installing in $(DEPLOY_DIR)"
	rm -rf $(DEPLOY_DIR)
	mkdir $(DEPLOY_DIR)
	cp -r ./src/Grasp.app $(DEPLOY_DIR)
	# Some Qt plugins (the SVG icon engine, for ex.) find their frameworks through a path relative to their own
	# location (@loader_path/../../../../lib, i.e. <Qt prefix>/lib). macdeployqt resolves this path from the copy
	# of the plugin in the bundle, i.e. $(DEPLOY_DIR)/lib : this directory temporarily points to the Qt libraries
	# (with Homebrew, it gathers the frameworks installed by separate packages, such as qtsvg)
	ln -sfn $(QT_LIBS) $(DEPLOY_DIR)/lib
	$(MACDEPLOYQT) $(DEPLOY_DIR)/Grasp.app # Add Framework
	rm -f $(DEPLOY_DIR)/lib
	cp -f $(INSTALL_DIR)/rfsmc.exe $(DEPLOY_DIR)/Grasp.app/Contents/MacOS
	cp -f ./src/options_spec.txt $(DEPLOY_DIR)/Grasp.app/Contents/MacOS
	cp -f $(INSTALL_DIR)/grasp.conf $(DEPLOY_DIR)/Grasp.app/Contents/MacOS
	# macdeployqt modifies the copied frameworks and libraries, which invalidates their signature : on Apple
	# Silicon, the app is then killed at launch ("Code Signature Invalid"). The whole bundle (including the
	# files copied above) is signed again, with an ad-hoc signature
	codesign --force --deep --sign - $(DEPLOY_DIR)/Grasp.app
	mkdir $(DEPLOY_DIR)/doc
	cp  doc/Using.md $(DEPLOY_DIR)/doc
	cp -r doc/imgs $(DEPLOY_DIR)/doc
	mkdir $(DEPLOY_DIR)/examples
	cp -r examples/* $(DEPLOY_DIR)/examples
	rm -f $(DEPLOY_DIR)/examples/Makefile
	cp {CHANGES.md,KNOWN-BUGS.md,LICENSE,README.md} $(DEPLOY_DIR)
	ln -s /Applications $(DEPLOY_DIR)/Applications

run:
	$(DEPLOY_DIR)/Grasp.app/Contents/MacOS/Grasp


GRASP_VOLUME=Grasp-$(VERSION)

installer:
	@echo "** Creating disk image"
	hdiutil create -volname $(GRASP_VOLUME) -srcfolder $(DEPLOY_DIR) -ov -format UDZO ./binaries/Grasp-$(VERSION)-$(ARCH).dmg

clean:
	(cd src; qmake; make clean)

clobber: clean
	(cd src; qmake; make distclean)
	rm -rf $(INSTALL_DIR)/Grasp.app
	rm -rf $(INSTALL_DIR)/doc
	rm -rf $(INSTALL_DIR)/examples
	rm -f $(INSTALL_DIR)/{CHANGES.md,KNOWN-BUGS.md,LICENSE,README.md}
