Grasp.app/Contents/PkgInfo: 
	@test -d Grasp.app/Contents || mkdir -p Grasp.app/Contents
	@$(DEL_FILE) Grasp.app/Contents/PkgInfo
	@echo "APPL????" > Grasp.app/Contents/PkgInfo
Grasp.app/Contents/Info.plist: 
	@test -d Grasp.app/Contents || mkdir -p Grasp.app/Contents
	@$(DEL_FILE) Grasp.app/Contents/Info.plist
	@plutil -convert xml1 -o - ../../../../Qt2/6.9.1/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.Grasp,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.Grasp,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},12,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,Grasp,g" -e "s,@LIBRARY@,Grasp,g" -e "s,\$${EXECUTABLE_NAME},Grasp,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >Grasp.app/Contents/Info.plist

